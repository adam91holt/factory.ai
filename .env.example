# Linear personal API key (same source as ~/ProjectManagement apps).
# NOTE (ADR-0003): workers never see this — it stays in the daemon process only.
LINEAR_API_KEY=

# Teams the factory watches. Comma-separated Linear team KEYS.
# v1: FAC only. Future teams are a config change, not a code change.
FACTORY_TEAM_KEYS=FAC

# CLIProxyAPI (loopback) — used ONLY for the Codex reviewer leg.
# Claude roles use direct SDK auth (your local Claude Code login) per plan v0.2.
PROXY_BASE_URL=http://127.0.0.1:8317
PROXY_AUTH_TOKEN=

# Models per role (Claude roles use aliases via direct auth; codex via proxy catalog id).
IMPLEMENTER_MODEL=sonnet
REVIEWER_CLAUDE_MODEL=opus
REVIEWER_CODEX_MODEL=gpt-5.6-sol
FIXER_MODEL=sonnet
SCOUT_MODEL=sonnet
PLANNER_MODEL=opus
STEWARD_MODEL=claude-fable-5
# Taste layer: adversarial UI/UX reviewer + verification agent.
DESIGN_REVIEWER_MODEL=opus
TESTER_MODEL=sonnet

# Risk-based model tiers (issue #6 Part 2, src/risk.ts). OPTIONAL: each stage's
# base var above IS its "standard" tier; declare `<VAR>_CHEAP` / `<VAR>_STRONG`
# to give the risk router something to route to. Risk class (low|medium|high|
# critical) is derived IN CODE from diff shape + guarded/sensitive paths —
# never from ticket text — and the tier-per-risk table is the in-code
# RISK_MODEL_TIERS constant. Unset = every risk class runs the standard model
# (exactly today's behavior). Red gates also buy ONE escalated fixer retry on
# the next tier up before the repair rounds (bound in code, not here).
# NOTE: declaring a _CHEAP/_STRONG var on REVIEWER_CLAUDE / REVIEWER_CODEX /
# SECURITY_REVIEWER activates the vendor-diversity assertion: at high/critical
# risk the security reviewer must not resolve to the same vendor as BOTH
# code-review legs, or config load fails loudly.
# NOTE: only the FIXER (which produces no gate verdict) ever routes to a
# _CHEAP tier. Tester and design-reviewer verdicts feed merge evidence /
# hold reasons, so RISK_MODEL_TIERS floors them at standard even at low
# risk — their _CHEAP vars are accepted but currently never selected.
# FIXER_MODEL_CHEAP=
# FIXER_MODEL_STRONG=
# TESTER_MODEL_CHEAP=
# TESTER_MODEL_STRONG=
# DESIGN_REVIEWER_MODEL_CHEAP=
# DESIGN_REVIEWER_MODEL_STRONG=
# REVIEWER_CLAUDE_MODEL_STRONG=
# REVIEWER_CODEX_MODEL_STRONG=
# SECURITY_REVIEWER_MODEL_STRONG=

# #14/#11 resilience: optional GLOBAL fallback model. When a stage's primary
# model exhausts bounded retries on a TRANSIENT failure (429 / "cooling down" /
# network drop — see agents.ts isTransientStageError), runStage fails the
# stage over to this model instead of hard-failing outright. Empty (default) =
# no fallback: a stage that exhausts retries on a real 429 still fails exactly
# as it did before this — but agents.ts logs loudly that a fallback would have
# helped. Pick a model from a DIFFERENT vendor/credential pool than your
# primary roster if the goal is surviving a whole-provider outage.
# FALLBACK_MODEL=

# Where factory worktrees live. NEVER ~/RapidoCoding (Adam's live checkouts).
FACTORY_WORK_ROOT=~/FactoryWork

# Durable store (Postgres — the ONLY production path; there is no SQLite
# fallback). The checked-in docker-compose.yml brings up the matching loopback
# instance: `bun run db:up`. LEAVE THIS COMMENTED OUT to use that default.
#
#   unset  → postgres://factory:factory-local-dev@127.0.0.1:5460/factory
#   set    → your own connection string (keep it loopback-only; it is a secret)
#   empty  → "no database configured"; startEventStore() refuses to open one.
#            That is what the test suite sets — `bun test` runs on an
#            in-process PGlite (WASM Postgres) seam and needs NO container.
# FACTORY_DATABASE_URL=postgres://factory:factory-local-dev@127.0.0.1:5460/factory
# Password baked into docker-compose.yml's default; override BOTH together.
# FACTORY_PG_PASSWORD=factory-local-dev

# Governance (plan v0.2 §7: turns/wall-clock primary, USD backstop).
MAX_TURNS_IMPLEMENTER=40
MAX_TURNS_REVIEWER=8
MAX_TURNS_FIXER=30
MAX_WALL_MINUTES_PER_ISSUE=45
MAX_BUDGET_USD_PER_ISSUE=25
# Prerequisite-0 rolling spend cap (docs/planning/autonomy.md "Build order" item
# 0): trailing-24h spend across EVERY issue/stage, not just one. Exceeding it
# enters drain mode — no new work claimed, in-flight issues finish.
MAX_BUDGET_USD_PER_DAY=200
MAX_VERIFIER_ITERATIONS=3
# Max design-review (taste-gate) passes on UI changes; a fixer runs between passes.
# 1 = single review pass with NO fix loop. 0 or invalid values fall back to the default (2).
TASTE_MAX_ROUNDS=2
WIP_LIMIT=4
WATCH_INTERVAL_SECONDS=60

# DASHBOARD_PORT=8787   # mission-control UI (127.0.0.1 only; 0 disables; off by default in --once/--dry)

# Prerequisite-0 alerting (docs/planning/autonomy.md "Build order" item 0).
# Optional ntfy/Slack-style webhook URL. Empty (default) = no notifications sent.
# ALERT_WEBHOOK_URL=

# Approvals inbox macOS notification (notify.ts): one osascript toast per NEW
# approval item ("Factory needs you: FAC-43 — …" + the /approvals URL). ON by
# default — local-only UX, throttled to one per item, a clean no-op off macOS.
# Set to 0 to disable.
# APPROVALS_NOTIFY=1

# Groundskeepers (per-project loop masters, roadmap "Groundskeeper spec v2").
# GLOBAL kill-switch. Loop masters GENERATE new work (and new spend), so they
# ship OFF: unset/empty/0 = disabled. Set to 1 (or true/yes/on) to arm them —
# and even then, ONLY groundskeepers/<name>.md cards with `enabled: true` run.
# Both gates must be true. Leave this at 0 unless you intend unattended spend.
GROUNDSKEEPERS_ENABLED=0

# Gap-5 post-merge deploy/smoke/AUTO-REVERT (bookends). GLOBAL kill-switch.
# Deploy runs a project's real deploy command and can auto-revert main, so it
# ships OFF: unset/empty/0 = disabled. Set to 1 (or true/yes/on) to arm it — and
# even then, ONLY projects/<name>.md cards with `deployEnabled: true` deploy, and
# deploy/smoke commands come ONLY from the human-reviewed card, never ticket text.
# Both gates must be true. Leave at 0 unless you intend unattended deploys.
DEPLOY_ENABLED=0

# Default GitHub org/owner for `gh repo create` during project bootstrap
# (idea -> private repo). A bootstrap ticket may name org/name explicitly; this
# is the fallback owner. Empty means the ticket MUST name a fully-qualified repo.
FACTORY_BOOTSTRAP_ORG=

# Optional: relocate the project registry cards (projects/<name>.md) off the repo
# tree. Empty (default) uses the repo's own projects/ directory, like agents/ and
# groundskeepers/. projects/ is a GUARDED PATH — cards are human-reviewed self-mods.
# FACTORY_PROJECTS_DIR=

# Extra EXACT origins the dashboard's write guard accepts beyond loopback —
# set to your `tailscale serve` HTTPS name to approve/push-back from the
# tailnet (e.g. https://<machine>.<tailnet>.ts.net). Empty = loopback only.
# FACTORY_TRUSTED_ORIGINS=
