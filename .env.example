# Linear personal API key (same source as ~/ProjectManagement apps).
# NOTE (ADR-0003): workers never see this — it stays in the daemon process only.
LINEAR_API_KEY=

# Teams the factory watches. Comma-separated Linear team KEYS.
# v1: FAC only. Future teams are a config change, not a code change.
FACTORY_TEAM_KEYS=FAC

# CLIProxyAPI (loopback) — used ONLY for the Codex reviewer leg.
# Claude roles use direct SDK auth (your local Claude Code login) per plan v0.2.
PROXY_BASE_URL=http://127.0.0.1:8317
PROXY_AUTH_TOKEN=

# Models per role (Claude roles use aliases via direct auth; codex via proxy catalog id).
IMPLEMENTER_MODEL=sonnet
REVIEWER_CLAUDE_MODEL=opus
REVIEWER_CODEX_MODEL=gpt-5.6-sol
FIXER_MODEL=sonnet
SCOUT_MODEL=sonnet
PLANNER_MODEL=opus
STEWARD_MODEL=claude-fable-5
# Taste layer: adversarial UI/UX reviewer + verification agent.
DESIGN_REVIEWER_MODEL=opus
TESTER_MODEL=sonnet

# Where factory worktrees live. NEVER ~/RapidoCoding (Adam's live checkouts).
FACTORY_WORK_ROOT=~/FactoryWork

# Governance (plan v0.2 §7: turns/wall-clock primary, USD backstop).
MAX_TURNS_IMPLEMENTER=40
MAX_TURNS_REVIEWER=8
MAX_TURNS_FIXER=30
MAX_WALL_MINUTES_PER_ISSUE=45
MAX_BUDGET_USD_PER_ISSUE=25
MAX_VERIFIER_ITERATIONS=3
# Max design-review (taste-gate) passes on UI changes; a fixer runs between passes.
# 1 = single review pass with NO fix loop. 0 or invalid values fall back to the default (2).
TASTE_MAX_ROUNDS=2
WIP_LIMIT=4
WATCH_INTERVAL_SECONDS=60

# DASHBOARD_PORT=8787   # mission-control UI (127.0.0.1 only; 0 disables; off by default in --once/--dry)

# Groundskeepers (per-project loop masters, roadmap "Groundskeeper spec v2").
# GLOBAL kill-switch. Loop masters GENERATE new work (and new spend), so they
# ship OFF: unset/empty/0 = disabled. Set to 1 (or true/yes/on) to arm them —
# and even then, ONLY groundskeepers/<name>.md cards with `enabled: true` run.
# Both gates must be true. Leave this at 0 unless you intend unattended spend.
GROUNDSKEEPERS_ENABLED=0

# Gap-5 post-merge deploy/smoke/AUTO-REVERT (bookends). GLOBAL kill-switch.
# Deploy runs a project's real deploy command and can auto-revert main, so it
# ships OFF: unset/empty/0 = disabled. Set to 1 (or true/yes/on) to arm it — and
# even then, ONLY projects/<name>.md cards with `deployEnabled: true` deploy, and
# deploy/smoke commands come ONLY from the human-reviewed card, never ticket text.
# Both gates must be true. Leave at 0 unless you intend unattended deploys.
DEPLOY_ENABLED=0

# Default GitHub org/owner for `gh repo create` during project bootstrap
# (idea -> private repo). A bootstrap ticket may name org/name explicitly; this
# is the fallback owner. Empty means the ticket MUST name a fully-qualified repo.
FACTORY_BOOTSTRAP_ORG=

# Optional: relocate the project registry cards (projects/<name>.md) off the repo
# tree. Empty (default) uses the repo's own projects/ directory, like agents/ and
# groundskeepers/. projects/ is a GUARDED PATH — cards are human-reviewed self-mods.
# FACTORY_PROJECTS_DIR=
