# Linear personal API key (same source as ~/ProjectManagement apps).
# NOTE (ADR-0003): workers never see this — it stays in the daemon process only.
LINEAR_API_KEY=

# Teams the factory watches. Comma-separated Linear team KEYS.
# v1: FAC only. Future teams are a config change, not a code change.
FACTORY_TEAM_KEYS=FAC

# CLIProxyAPI (loopback) — used ONLY for the Codex reviewer leg.
# Claude roles use direct SDK auth (your local Claude Code login) per plan v0.2.
PROXY_BASE_URL=http://127.0.0.1:8317
PROXY_AUTH_TOKEN=

# Models per role (Claude roles use aliases via direct auth; codex via proxy catalog id).
IMPLEMENTER_MODEL=sonnet
REVIEWER_CLAUDE_MODEL=opus
REVIEWER_CODEX_MODEL=gpt-5.6-sol
FIXER_MODEL=sonnet
SCOUT_MODEL=sonnet
PLANNER_MODEL=opus

# Where factory worktrees live. NEVER ~/RapidoCoding (Adam's live checkouts).
FACTORY_WORK_ROOT=~/FactoryWork

# Governance (plan v0.2 §7: turns/wall-clock primary, USD backstop).
MAX_TURNS_IMPLEMENTER=40
MAX_TURNS_REVIEWER=8
MAX_TURNS_FIXER=30
MAX_WALL_MINUTES_PER_ISSUE=45
MAX_BUDGET_USD_PER_ISSUE=25
MAX_VERIFIER_ITERATIONS=3
WIP_LIMIT=4
WATCH_INTERVAL_SECONDS=60

# DASHBOARD_PORT=8787   # mission-control UI (127.0.0.1 only; 0 disables; off by default in --once/--dry)
