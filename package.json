{
  "name": "@rapido/factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The software factory: Linear-driven implementer→adversarial-review→fixer→verify→PR loop on the Claude Agent SDK, multi-vendor via CLIProxyAPI.",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "factory": "node --env-file=.env --experimental-strip-types src/index.ts",
    "factory:once": "node --env-file=.env --experimental-strip-types src/index.ts --once",
    "factory:dry": "node --env-file=.env --experimental-strip-types src/index.ts --once --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
