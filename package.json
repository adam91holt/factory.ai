{
  "name": "@rapido/factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The software factory: Linear-driven implementer→adversarial-review→fixer→verify→PR loop on the Claude Agent SDK, multi-vendor via CLIProxyAPI. Bun runtime.",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "factory": "bun src/index.ts",
    "factory:once": "bun src/index.ts --once",
    "factory:dry": "bun src/index.ts --once --dry-run",
    "factory:server": "bun src/index.ts --server-only",
    "ui:dev": "bun run --cwd ui dev",
    "ui:build": "bun run --cwd ui build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.215"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
